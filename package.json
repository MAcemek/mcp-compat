{
  "name": "mcp-compat",
  "version": "0.1.0",
  "description": "Check which MCP protocol versions and transports a server works with, and which clients can connect to it.",
  "type": "module",
  "bin": {
    "mcp-compat": "lib/index.js"
  },
  "files": [
    "lib/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:action && npm run build:cli",
    "build:action": "ncc build src/action.ts -o dist --license licenses.txt",
    "build:cli": "ncc build src/cli.ts -o lib --license licenses.txt",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "prepack": "npm run build:cli",
    "all": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MAcemek/mcp-compat.git"
  },
  "bugs": {
    "url": "https://github.com/MAcemek/mcp-compat/issues"
  },
  "homepage": "https://github.com/MAcemek/mcp-compat#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "compatibility",
    "protocol-version",
    "stdio",
    "streamable-http",
    "github-action",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
